{
  "extends": ".forgepy/pyrightconfig.json",
  "include": ["library", "project", "conftest.py"],
  "exclude": ["*/src/ignition/startup", "*/src/ignition/update", "*/src/ignition/shutdown", "**/.venv*"],
  "extraPaths": ["library/src/ignition/script-python", "project/src/ignition/script-python"],
  "venvPath": ".",
  "venv": ".venv",
  "typeCheckingMode": "standard",
  "reportMissingModuleSource": "none",
  "defineConstant": {
    "MYPY": true
  },
  "reportTypeCommentUsage": false
}
