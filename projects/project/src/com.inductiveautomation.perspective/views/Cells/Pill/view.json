{
  "custom": {},
  "params": {
    "value": ""
  },
  "propConfig": {
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 32,
      "width": 110
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Pill"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.style.classes": {
            "binding": {
              "config": {
                "expression": "case({view.params.value}, \"Online\", \"Pill/Base Pill/Ok\", \"Offline\", \"Pill/Base Pill/Bad\", \"Acknowledged\", \"Pill/Base Pill/Ack\", \"Note\", \"Pill/Base Pill/Note\", \"Pill/Base Pill/Info\")"
              },
              "type": "expr"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.value"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "classes": "Pill/Base"
          },
          "text": ""
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "alignItems": "center",
      "direction": "row",
      "style": {
        "overflow": "hidden"
      }
    },
    "type": "ia.container.flex"
  }
}
