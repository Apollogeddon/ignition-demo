{
  "custom": {},
  "params": {
    "color": "",
    "dark": false,
    "text": "",
    "tooltip": ""
  },
  "propConfig": {
    "params.color": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.dark": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.text": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.tooltip": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 30,
      "width": 40
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Value"
        },
        "position": {
          "basis": "0px",
          "grow": 1
        },
        "propConfig": {
          "meta.tooltip.enabled": {
            "binding": {
              "config": {
                "expression": "len({view.params.tooltip}) > 0"
              },
              "type": "expr"
            }
          },
          "meta.tooltip.text": {
            "binding": {
              "config": {
                "path": "view.params.tooltip"
              },
              "type": "property"
            }
          },
          "props.style.classes": {
            "binding": {
              "config": {
                "expression": "if({view.params.dark}, 'Heat/Text Heat/TextDark', 'Heat/Text')"
              },
              "type": "expr"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.text"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "classes": "Heat/Text"
          },
          "text": ""
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "name": "root"
    },
    "propConfig": {
      "props.style.backgroundColor": {
        "binding": {
          "config": {
            "path": "view.params.color"
          },
          "type": "property"
        }
      }
    },
    "props": {
      "alignItems": "stretch",
      "direction": "row",
      "style": {
        "classes": "Heat/Cell"
      }
    },
    "type": "ia.container.flex"
  }
}
