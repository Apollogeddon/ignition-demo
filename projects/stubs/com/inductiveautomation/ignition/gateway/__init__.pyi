# The gateway's own context, which library.gateway81 reaches for the 8.1 configuration
# store: only what the scripts use. Read through pyrightconfig.json's stubPath, this
# module replaces the Ignition API stubs' one, which is empty in 8.1 and 8.3; its
# subpackages still come from those stubs.

from typing import Any

from simpleorm.dataset import SQuery

# the gateway's internal database of configuration records
class PersistenceInterface:
	def query(self, query: SQuery) -> list[Any]: ...
	def createNew(self, meta: Any) -> Any: ...
	def save(self, record: Any) -> None: ...

# the managers behind the gateway's web UI
class GatewayContext:
	def getPersistenceInterface(self) -> PersistenceInterface: ...
	def getModuleManager(self) -> Any: ...
	def getUserSourceManager(self) -> Any: ...
	def getAlarmManager(self) -> Any: ...
	def getAuditManager(self) -> Any: ...
	def getEmailProfileManager(self) -> Any: ...
	def getSecurityLevelManager(self) -> Any: ...
	def getSystemPropertiesManager(self) -> Any: ...

class IgnitionGateway:
	@staticmethod
	def get() -> GatewayContext: ...
