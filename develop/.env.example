# Copy to develop/.env (git-ignored) and change the passwords.

# Ignition version for the gateway image: any 8.1 or 8.3 image tag
IGNITION_VERSION=8.3.10
# IGNITION_VERSION=8.1.55

IGNITION_ADMIN_PASSWORD=change-me
DB_PASSWORD=change-me
# password of the seeded demo users (operator, engineer) on 8.1
DEMO_USERS_PASSWORD=change-me

# Host ports and the gateway JVM heap
GATEWAY_HTTP_PORT=8088
GATEWAY_HTTPS_PORT=8043
DB_PORT=5432
GATEWAY_MEMORY_MB=1024
