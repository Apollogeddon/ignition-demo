# Containers and Ignition read these files as-is; keep LF on every platform
* text=auto eol=lf
*.ps1 text eol=crlf
*.png binary
*.gwbk binary
*.modl binary

# Ignition project resources pass through the sanitiser on commit (see
# scripts/setup-git.sh); without the filter configured git stores them as-is
resource.json filter=ignition-resource
