# Copy to backend.hcl (git-ignored) and run: tofu init -backend-config=backend.hcl
# The state goes in the Secret tfstate-<workspace>-<secret_suffix> in namespace,
# locked by a Lease of the same name. Create the namespace first:
#   kubectl create namespace tofu-state
secret_suffix  = "ignition-infra"
namespace      = "tofu-state"
config_path    = "~/.kube/config"
config_context = "default"
