---
const features = [
  {
    title: "Projects as code",
    description:
      "Projects live in the repository as the Designer's files, and a sanitiser strips timestamps and signatures so diffs stay clean.",
    icon: `<svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M18 19a5 5 0 0 1-5-5v8" /><path d="M9 20H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.69.9l.81 1.2a2 2 0 0 0 1.67.9H20a2 2 0 0 1 2 2v5" /><circle cx="13" cy="12" r="2" /><circle cx="20" cy="19" r="2" /></svg>`,
  },
  {
    title: "Tested scripts",
    description:
      "Gateway scripts are linted, type-checked and unit tested under Python 3, while still running on Jython 2.7 in the gateway.",
    icon: `<svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2v6a2 2 0 0 0 .245.96l5.51 10.08A2 2 0 0 1 18 22H6a2 2 0 0 1-1.755-2.96l5.51-10.08A2 2 0 0 0 10 8V2" /><path d="M6.453 15h11.094" /><path d="M8.5 2h7" /></svg>`,
  },
  {
    title: "Immutable gateway image",
    description:
      "Projects are baked into the gateway image: shipping means a new tag, and rolling back means deploying the previous one.",
    icon: `<svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="m16 16 2 2 4-4" /><path d="M21 10V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l2-1.14" /><path d="m7.5 4.27 9 5.15" /><polyline points="3.29 7 12 12 20.71 7" /><line x1="12" x2="12" y1="22" y2="12" /></svg>`,
  },
  {
    title: "Platform as code",
    description:
      "OpenTofu installs the ignition-failover chart with redundancy, TLS and active routing, plus the PostgreSQL database.",
    icon: `<svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="m10.852 19.772-.383.924" /><path d="m13.148 14.228.383-.923" /><path d="M13.148 19.772a3 3 0 1 0-2.296-5.544l-.383-.923" /><path d="m13.53 20.696-.382-.924a3 3 0 1 1-2.296-5.544" /><path d="m14.772 15.852.923-.383" /><path d="m14.772 18.148.923.383" /><path d="M4.2 15.1a7 7 0 1 1 9.93-9.858A7 7 0 0 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.2" /><path d="m9.228 15.852-.923-.383" /><path d="m9.228 18.148-.923.383" /></svg>`,
  },
  {
    title: "Gateway resources as code",
    description:
      "OpenTofu's resources module creates the gateway's database connection, alarm journal, users and identity provider through its REST API.",
    icon: `<svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14 17H5" /><path d="M19 7h-9" /><circle cx="17" cy="17" r="3" /><circle cx="7" cy="7" r="3" /></svg>`,
  },
  {
    title: "One owner per setting",
    description:
      "The image owns projects, the chart owns redundancy and certificates, and OpenTofu owns the gateway's resources.",
    icon: `<svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M2 21a8 8 0 0 1 13.292-6" /><circle cx="10" cy="8" r="5" /><path d="m16 19 2 2 4-4" /></svg>`,
  },
];
---

<section class="features-section">
  <p class="section-eyebrow">Features</p>
  <h2>Why use this template?</h2>
  
  <div class="grid">
    {features.map(feature => (
      <div class="feature-card">
        <div class="icon-wrapper" set:html={feature.icon}></div>
        <h3>{feature.title}</h3>
        <p>{feature.description}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .features-section {
    box-sizing: border-box;
    max-width: var(--sl-content-width);
    margin: 0 auto;
    padding: 5rem 1.5rem;
    text-align: center;
  }

  h2 {
    margin: 0 auto 3rem;
    max-width: 22ch;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    line-height: 1.15;
    font-weight: 600;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 1rem;
  }

  /* a flat card that lifts its border on hover */
  .feature-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.5rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 12px;
    background: var(--sl-color-surface);
    text-align: left;
    transition: border-color 0.15s;
  }

  .feature-card:hover {
    border-color: var(--sl-color-hairline-strong);
  }

  .icon-wrapper {
    display: flex;
    margin-bottom: 0.75rem;
    color: var(--sl-color-accent-text, var(--sl-color-accent));
  }

  .icon-wrapper :global(svg) {
    width: 20px;
    height: 20px;
  }

  h3 {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--sl-color-text);
  }

  p {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--sl-color-text-muted);
  }
</style>
