---
const base = import.meta.env.BASE_URL;

const models = [
  {
    name: "Develop",
    tagline: "Edit locally",
    description:
      "A gateway and database in Docker Compose, built from the same gateway image, with the project folders mounted live so Designer edits land straight in the repository.",
    stats: [
      { label: "Runs on", value: "Compose" },
      { label: "Projects", value: "Live" },
      { label: "Ignition", value: "8.1 / 8.3" },
    ],
    features: ["Designer edits saved", "Same image", "Quick reset"],
    link: `${base}/docs/components/develop/`,
    icon: `<svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M18 5a2 2 0 0 1 2 2v8.526a2 2 0 0 0 .212.897l1.068 2.127a1 1 0 0 1-.9 1.45H3.62a1 1 0 0 1-.9-1.45l1.068-2.127A2 2 0 0 0 4 15.526V7a2 2 0 0 1 2-2z" /><path d="M20.054 15.987H3.946" /></svg>`,
  },
  {
    name: "Cluster",
    tagline: "Deploy everywhere",
    description:
      "OpenTofu installs the gateway image on Kubernetes as a redundant pair, then configures the running gateway through its REST API. Every environment is built the same way.",
    stats: [
      { label: "Runs on", value: "Kubernetes" },
      { label: "Projects", value: "Baked in" },
      { label: "Gateways", value: "Redundant" },
    ],
    features: ["Active routing", "Rollback by tag", "Configuration as code"],
    link: `${base}/docs/components/cluster/`,
    icon: `<svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M22 7.7c0-.6-.4-1.2-.8-1.5l-6.3-3.9a1.72 1.72 0 0 0-1.7 0l-10.3 6c-.5.2-.9.8-.9 1.4v6.6c0 .5.4 1.2.8 1.5l6.3 3.9a1.72 1.72 0 0 0 1.7 0l10.3-6c.5-.3.9-1 .9-1.5Z" /><path d="M10 21.9V14L2.1 9.1" /><path d="m10 14 11.9-6.9" /><path d="M14 19.8v-8.1" /><path d="M18 17.5V9.4" /></svg>`,
  },
];
---

<section class="comparison-section">
  <div class="header">
    <p class="section-eyebrow">Get going</p>
    <h2>Choose your environment</h2>
    <p>Develop against a local gateway, then deploy the same image to a cluster.</p>
  </div>

  <div class="comparison-grid">
    {models.map(model => (
      <div class="model-card glass">
        <div class="model-header">
          <div class="icon-box" set:html={model.icon}></div>
          <div>
            <h3>{model.name}</h3>
            <p class="tag">{model.tagline}</p>
          </div>
        </div>
        
        <p class="desc">{model.description}</p>

        <div class="stats-grid">
          {model.stats.map(stat => (
            <div class="stat-item">
              <span class="stat-label">{stat.label}</span>
              <span class="stat-value">{stat.value}</span>
            </div>
          ))}
        </div>

        <ul class="features-list">
          {model.features.map(feature => (
            <li>
              <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
              {feature}
            </li>
          ))}
        </ul>

        <a href={model.link} class="btn-more">
          Read the docs
          <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14m-7-7 7 7-7 7"/></svg>
        </a>
      </div>
    ))}
  </div>
</section>

<style>
  .comparison-section {
    box-sizing: border-box;
    max-width: var(--sl-content-width);
    margin: 0 auto;
    padding: 3rem 1.5rem 6rem;
  }

  .header {
    text-align: center;
    margin-bottom: 3rem;
  }

  h2 {
    margin: 0 0 0.75rem;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    line-height: 1.15;
    font-weight: 600;
    letter-spacing: -0.035em;
  }

  .header p {
    margin: 0;
    font-size: 1.0625rem;
    color: var(--sl-color-text-muted);
  }

  .comparison-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: 1rem;
  }

  .model-card {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 2rem;
    border-radius: 16px;
    transition: border-color 0.15s;
  }

  .model-card:hover {
    border-color: var(--sl-color-hairline-strong);
  }

  .model-header {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .icon-box {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 10px;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-accent-text, var(--sl-color-accent));
  }

  .icon-box :global(svg) {
    width: 20px;
    height: 20px;
  }

  h3 {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .tag {
    margin: 0.125rem 0 0;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--sl-color-text-muted);
  }

  .desc {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--sl-color-text-muted);
  }

  /* the figures sit in one row, split by hairlines */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border: 1px solid var(--sl-color-hairline);
    border-radius: 12px;
    overflow: hidden;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    padding: 1rem 0.5rem;
    text-align: center;
  }

  .stat-item + .stat-item {
    border-left: 1px solid var(--sl-color-hairline);
  }

  .stat-label {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--sl-color-text-muted);
  }

  .stat-value {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--sl-color-text);
  }

  .features-list {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .features-list li {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 0.9375rem;
    color: var(--sl-color-text);
  }

  .features-list li svg {
    flex-shrink: 0;
    color: var(--sl-color-accent-text, var(--sl-color-accent));
  }

  .btn-more {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 44px;
    margin-top: auto;
    border: 1px solid var(--sl-color-hairline-strong);
    border-radius: 999px;
    color: var(--sl-color-text);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    transition: background-color 0.15s;
  }

  .btn-more:hover {
    background: var(--sl-color-gray-6);
  }
</style>
