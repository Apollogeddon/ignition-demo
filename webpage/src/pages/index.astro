---
import logoImage from "../assets/favicon.png";
import ArchitectureComparison from "../components/ArchitectureComparison.astro";
import FeatureGrid from "../components/FeatureGrid.astro";
import Hero from "../components/Hero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const year = new Date().getFullYear();
---

<BaseLayout title="Ignition Demo Stack · Ignition as code, end to end" description="A template for running Ignition as code: the gateway image, its configuration and its projects all come from one repository.">
  <Hero 
    tagline="A template for running Ignition as code: the gateway image, its configuration and its projects all come from one repository."
    logo={logoImage}
  />
  
  <FeatureGrid />
  
  <ArchitectureComparison />
  
  <footer class="custom-footer">
    <div class="footer-content">
      <p>© {year} Apollogeddon. Released under the MIT License.</p>
      <p>Ignition is a trademark of Inductive Automation.</p>
    </div>
  </footer>
</BaseLayout>
