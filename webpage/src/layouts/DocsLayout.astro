---
import type { MarkdownHeading } from "astro";
import ProseEnhance from "../components/ProseEnhance.astro";
import Sidebar from "../components/Sidebar.astro";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description?: string;
  headings?: MarkdownHeading[];
}

const { title, description, headings = [] } = Astro.props;

// a page with enough sections gets an "On this page" list of its h2s and h3s
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const showToc = toc.length >= 4;
---

<BaseLayout title={`${title} · Ignition Demo Stack`} description={description}>
	<div class:list={["docs-container", { "has-toc": showToc }]}>
		<aside class="sidebar-wrapper">
			<Sidebar />
		</aside>
		<article class="content-wrapper">
			<details class="docs-menu">
				<summary>Menu</summary>
				<Sidebar />
			</details>
			<div class="prose">
				<h1>{title}</h1>
				{
					showToc && (
						<details class="toc-inline">
							<summary>On this page</summary>
							<nav aria-label="On this page">
								<ul class="toc-list">
									{toc.map((h) => (
										<li class={`depth-${h.depth}`}>
											<a href={`#${h.slug}`}>{h.text}</a>
										</li>
									))}
								</ul>
							</nav>
						</details>
					)
				}
				<slot />
			</div>
		</article>
		{
			showToc && (
				<aside class="toc-rail">
					<nav aria-label="On this page">
						<h2 class="toc-title">On this page</h2>
						<ul class="toc-list">
							{toc.map((h) => (
								<li class={`depth-${h.depth}`}>
									<a href={`#${h.slug}`}>{h.text}</a>
								</li>
							))}
						</ul>
					</nav>
				</aside>
			)
		}
	</div>
	<ProseEnhance />
</BaseLayout>

<script>
	// following a link in the phone menu or the inline contents closes it
	for (const details of document.querySelectorAll<HTMLDetailsElement>(".docs-menu, .toc-inline")) {
		details.addEventListener("click", (e) => {
			if ((e.target as Element).closest("a")) details.open = false;
		});
	}

</script>

<style>
	.docs-container {
		display: flex;
		max-width: 1440px;
		margin: 0 auto;
		padding: 0 1.5rem;
	}

	.sidebar-wrapper {
		box-sizing: border-box;
		flex: 0 0 var(--sl-sidebar-width);
		width: var(--sl-sidebar-width);
		position: sticky;
		top: var(--sl-nav-height);
		height: calc(100vh - var(--sl-nav-height));
		border-right: 1px solid var(--sl-color-hairline);
		overflow-y: auto;
		padding: 2rem 0;
	}

	.content-wrapper {
		flex: 1;
		min-width: 0;
		padding: 2rem 4rem;
	}

	.prose {
		max-width: 80ch;
		margin: 0 auto;
	}

	.prose h1 {
		font-size: 2.5rem;
		margin-bottom: 2rem;
		border-bottom: 1px solid var(--sl-color-hairline);
		padding-bottom: 1rem;
		color: var(--sl-color-text);
	}

	/* the phone menu and the inline contents: a bordered bar that opens downwards */
	details {
		border: 1px solid var(--sl-color-hairline);
		border-radius: var(--sl-border-radius);
		background: var(--sl-color-gray-6);
	}

	summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		min-height: 44px;
		box-sizing: border-box;
		padding: 0.5rem 1rem;
		font-weight: 600;
		color: var(--sl-color-text);
		cursor: pointer;
		list-style: none;
	}

	summary::-webkit-details-marker {
		display: none;
	}

	summary::after {
		content: "";
		width: 0.5rem;
		height: 0.5rem;
		border-right: 2px solid currentColor;
		border-bottom: 2px solid currentColor;
		transform: translateY(-25%) rotate(45deg);
		transition: transform 0.2s;
	}

	details[open] > summary::after {
		transform: translateY(25%) rotate(-135deg);
	}

	details[open] > summary {
		border-bottom: 1px solid var(--sl-color-hairline);
	}

	.docs-menu {
		display: none;
		margin-bottom: 1.5rem;
	}

	.docs-menu :global(.sidebar) {
		padding: 0 0.5rem 0.5rem;
	}

	.docs-menu :global(.section) {
		margin-bottom: 0.5rem;
	}

	.toc-inline {
		margin: -1rem 0 2rem;
	}

	.toc-inline nav {
		padding: 0.5rem 1rem 0.75rem;
	}

	.toc-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.prose .toc-list li {
		margin: 0;
	}

	.toc-list a {
		display: block;
		padding: 0.3rem 0;
		color: var(--sl-color-text-muted);
		text-decoration: none;
		font-size: 0.9rem;
		line-height: 1.4;
	}

	.toc-list a:hover {
		color: var(--sl-color-accent);
	}

	.toc-list .depth-3 a {
		padding-left: 1rem;
	}

	.toc-rail {
		display: none;
	}

	/* wide screens: the contents move to a sticky right rail */
	@media (min-width: 1200px) {
		.toc-inline {
			display: none;
		}

		.toc-rail {
			display: block;
			box-sizing: border-box;
			flex: 0 0 14rem;
			position: sticky;
			top: var(--sl-nav-height);
			height: calc(100vh - var(--sl-nav-height));
			overflow-y: auto;
			padding: 2rem 0 2rem 1rem;
			border-left: 1px solid var(--sl-color-hairline);
		}

		.has-toc .content-wrapper {
			padding: 2rem 3rem;
		}
	}

	.toc-title {
		font-size: 0.75rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--sl-color-text-muted);
		margin: 0 0 0.75rem;
	}

	/* phones: the sidebar becomes a menu above the article; a 768px tablet keeps it */
	@media (max-width: 767px) {
		.sidebar-wrapper {
			display: none;
		}

		.docs-menu {
			display: block;
		}

		.content-wrapper {
			padding: 1.5rem 0;
		}

		.docs-container {
			padding: 0 1rem;
		}
	}
</style>
